<Project Sdk="Microsoft.NET.Sdk">

  <!-- The DAP side of eludite-dbg-mono without Mono.Debugging (brief 0022): messages, Content-Length framing, the
       request dispatcher, the handle tables and paging, and argument parsing. netstandard2.0 so it runs inside the
       net472 adapter under Mono and in the net10.0 tests. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Eludite.Debugger.Mono.Protocol</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

</Project>
