<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="StreamJsonRpc" Version="2.25.29" />
    <PackageVersion Include="Nerdbank.Streams" Version="2.14.354" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <!-- Brief 0007: FakeTimeProvider for the warming debounce tests (MIT). Tests only. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <!-- Brief 0003: design-time evaluation of legacy projects (MIT). Compile-time only; the MSBuild assemblies
         are loaded at run time from the located .NET SDK by Microsoft.Build.Locator. -->
    <PackageVersion Include="Microsoft.Build" Version="17.11.48" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="17.11.48" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.10.2" />
    <!-- Brief 0003: tools/legacy-load runner compiles the evaluator's output directly (MIT). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <!-- Brief 0022: eludite-dbg-mono, the Mono soft-debugger DAP server. Mono.Debugging.Soft (MIT; mono/debugger-libs,
         the 2017 build, the last published) brings Mono.Debugging (MIT), Mono.Debugger.Soft (MIT), Mono.Cecil 0.9.6
         (MIT) and ICSharpCode.NRefactory 5.5.1 (MIT). Newtonsoft.Json (MIT) carries DAP's JSON in the adapter's
         netstandard2.0 protocol library, which runs under Mono 6.8 and on .NET 10 (its tests). -->
    <PackageVersion Include="Mono.Debugging.Soft" Version="1.0.20170212.42" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Brief 0048: the NuGet client in eludite-host (NuGet.Client, Apache-2.0). The host loads the located SDK's MSBuild
         in-process (InProcessMsBuildEvaluator picks the newest SDK on the machine), and that MSBuild binds to the NuGet
         assemblies the host already loaded, which must then be at least the SDK's version: a lower one fails with
         "manifest definition does not match" (CI's runners carry SDK 10.0.4xx, NuGet 7.9; the pinned 10.0.302 has 7.6
         and is satisfied by 7.9). Raise these when a newer SDK's NuGet appears. -->
    <PackageVersion Include="NuGet.Protocol" Version="7.9.0" />
    <PackageVersion Include="NuGet.Configuration" Version="7.9.0" />
    <PackageVersion Include="NuGet.Versioning" Version="7.9.0" />
    <PackageVersion Include="NuGet.Packaging" Version="7.9.0" />
    <PackageVersion Include="NuGet.Resolver" Version="7.9.0" />
    <PackageVersion Include="NuGet.ProjectModel" Version="7.9.0" />
    <PackageVersion Include="NuGet.Credentials" Version="7.9.0" />
  </ItemGroup>
</Project>
