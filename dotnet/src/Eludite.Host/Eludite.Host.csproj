<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>eludite-host</AssemblyName>
    <RootNamespace>Eludite.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" />
    <!-- Legacy/ (brief 0003): compile against MSBuild, load the SDK's copy at run time through the locator. -->
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <!-- NuGet/ (brief 0048). -->
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="NuGet.Configuration" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="NuGet.Packaging" />
    <PackageReference Include="NuGet.Resolver" />
    <PackageReference Include="NuGet.ProjectModel" />
    <PackageReference Include="NuGet.Credentials" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Eludite.Web/Eludite.Web.csproj" />
    <ProjectReference Include="../Eludite.TestBridge/Eludite.TestBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Eludite.Host.Tests" />
  </ItemGroup>

</Project>
