<!-- Eludite's built-in code snippet (brief 0069; MIT, written for Eludite in Visual Studio's format). -->
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>record</Title>
      <Shortcut>record</Shortcut>
      <Description>Record</Description>
      <Author>Eludite</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>name</ID>
          <ToolTip>Record name</ToolTip>
          <Default>MyRecord</Default>
        </Literal>
      </Declarations>
      <Code Language="csharp"><![CDATA[public record $name$($end$);]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
