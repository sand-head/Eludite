<?xml version="1.0" encoding="utf-8"?>
<!-- Eludite's built-in code snippet (brief 0069; MIT, written for Eludite in Visual Studio's format). -->
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>exception</Title>
      <Shortcut>exception</Shortcut>
      <Description>Exception class</Description>
      <Author>Eludite</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>newException</ID>
          <ToolTip>Exception name</ToolTip>
          <Default>MyException</Default>
        </Literal>
      </Declarations>
      <Code Language="csharp"><![CDATA[[Serializable]
public class $newException$Exception : Exception
{
    public $newException$Exception() { }
    public $newException$Exception(string message) : base(message) { }
    public $newException$Exception(string message, Exception inner) : base(message, inner) { }
}$end$]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
