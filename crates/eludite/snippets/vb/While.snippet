<?xml version="1.0" encoding="utf-8"?>
<!-- Eludite's built-in code snippet (brief 0069; MIT, written for Eludite in Visual Studio's format). -->
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>While</Title>
      <Shortcut>While</Shortcut>
      <Description>While loop</Description>
      <Author>Eludite</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType><SnippetType>SurroundsWith</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>condition</ID>
          <ToolTip>Condition</ToolTip>
          <Default>True</Default>
        </Literal>
      </Declarations>
      <Code Language="VB"><![CDATA[While $condition$
    $selected$$end$
End While]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
