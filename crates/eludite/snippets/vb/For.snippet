<?xml version="1.0" encoding="utf-8"?>
<!-- Eludite's built-in code snippet (brief 0069; MIT, written for Eludite in Visual Studio's format). -->
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>For</Title>
      <Shortcut>For</Shortcut>
      <Description>For...Next loop</Description>
      <Author>Eludite</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType><SnippetType>SurroundsWith</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>index</ID>
          <ToolTip>Index</ToolTip>
          <Default>i</Default>
        </Literal>
        <Literal>
          <ID>max</ID>
          <ToolTip>Upper bound</ToolTip>
          <Default>10</Default>
        </Literal>
      </Declarations>
      <Code Language="VB"><![CDATA[For $index$ As Integer = 0 To $max$
    $selected$$end$
Next]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
