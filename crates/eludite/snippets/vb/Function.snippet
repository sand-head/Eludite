<?xml version="1.0" encoding="utf-8"?>
<!-- Eludite's built-in code snippet (brief 0069; MIT, written for Eludite in Visual Studio's format). -->
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Function</Title>
      <Shortcut>Function</Shortcut>
      <Description>Function procedure</Description>
      <Author>Eludite</Author>
      <SnippetTypes><SnippetType>Expansion</SnippetType></SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>name</ID>
          <ToolTip>Name</ToolTip>
          <Default>MyFunction</Default>
        </Literal>
        <Literal>
          <ID>type</ID>
          <ToolTip>Return type</ToolTip>
          <Default>Integer</Default>
        </Literal>
      </Declarations>
      <Code Language="VB"><![CDATA[Public Function $name$() As $type$
    $end$
End Function]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
