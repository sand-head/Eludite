<Project Sdk="Microsoft.NET.Sdk">
  <!-- Brief 0003 runner: loads each corpus project through eludite-host's legacy evaluators and the Roslyn LS. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>legacy-load</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../dotnet/src/Eludite.Host/Eludite.Host.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
</Project>
