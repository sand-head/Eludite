<?xml version="1.0" encoding="utf-8"?>
<!-- Restore from nuget.org only, whatever feeds the machine-wide config adds: with Central Package Management a
     second source fails restore with NU1507 under warnings as errors. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
