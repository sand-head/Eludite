<?xml version="1.0" encoding="utf-8"?>
<!-- Brief 0048's corpus: the local feed only (feed/, built by build.sh or by the tests), and a global packages folder of
     its own (.packages/), so restoring the corpus never touches the machine's ~/.nuget/packages or a network source. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".packages" />
  </config>
  <packageSources>
    <clear />
    <add key="corpus" value="feed" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
