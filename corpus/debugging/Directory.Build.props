<Project>
  <!-- The seeded-bug corpus (brief 0030). Stops MSBuild's search for a Directory.Build.props further up, so the corpus
       builds the same wherever it is checked out. Each project file names its own OutputType and TargetFrameworks
       (Eludite reads them from the project file); C# 7.3 is the language both of its frameworks compile. -->
  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- Debuggable as written: no optimization, and the real source paths in the PDB even in a CI build, since
         breakpoints bind by path. -->
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
    <DeterministicSourcePaths>false</DeterministicSourcePaths>
  </PropertyGroup>
</Project>
