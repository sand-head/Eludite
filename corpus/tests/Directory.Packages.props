<Project>
  <!-- The test frameworks of the corpus (brief 0035), one per protocol and framework: xunit.v3 and MSTest on
       Microsoft.Testing.Platform, xunit 2 and NUnit on VSTest. All MIT, except NUnit and NUnit3TestAdapter (MIT too).
       FSharp.Core (MIT; brief 0057): the F# SDK's implicit reference takes its version from here under central package
       management, and without one the assembly is never copied beside Corpus.FSharp.dll, so no test loads. The version
       is the one the pinned SDK (global.json) ships in FSharp/library-packs. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="MSTest" Version="4.4.1" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="FSharp.Core" Version="10.1.302" />
  </ItemGroup>
</Project>
