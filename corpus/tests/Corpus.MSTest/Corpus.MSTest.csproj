<Project Sdk="Microsoft.NET.Sdk">

  <!-- MSTest on Microsoft.Testing.Platform: MSTest's own runner makes the project an executable that speaks MTP's server
       mode. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Corpus.MSTest</RootNamespace>
    <EnableMSTestRunner>true</EnableMSTestRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

</Project>
