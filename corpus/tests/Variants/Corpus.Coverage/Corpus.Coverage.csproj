  <ItemGroup>
    <PackageReference Include="MSTest" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Corpus.Calculator/Corpus.Calculator.csproj" />
  </ItemGroup>

</Project>
