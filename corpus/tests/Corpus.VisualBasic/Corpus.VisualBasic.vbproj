<Project Sdk="Microsoft.NET.Sdk">

  <!-- Visual Basic on MSTest on Microsoft.Testing.Platform (brief 0057): MSTest's own runner makes the project an
       executable that speaks MTP's server mode, exactly as Corpus.MSTest does for C#. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Corpus.VisualBasic</RootNamespace>
    <EnableMSTestRunner>true</EnableMSTestRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
  </ItemGroup>

</Project>
