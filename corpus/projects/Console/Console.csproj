<Project Sdk="Microsoft.NET.Sdk">

  <!-- The console program of the property pages corpus (brief 0049). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- A comment inside a property group stays where it is. -->
    <RootNamespace>Corpus.Console</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DefineConstants>$(DefineConstants);RELEASE_ONLY</DefineConstants>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="notes.txt" />
  </ItemGroup>

</Project>
