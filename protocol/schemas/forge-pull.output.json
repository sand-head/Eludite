{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/Eludite/protocol/schemas/forge-pull.output.json",
  "title": "eludite.forge.pull output",
  "description": "The pull request.",
  "type": "object",
  "required": [
    "id",
    "title",
    "state",
    "author",
    "head",
    "base",
    "url",
    "stale"
  ],
  "additionalProperties": false,
  "properties": {
    "number": {
      "description": "The pull request's or issue's number on the forge (GitHub's and Forgejo's number, GitLab's `iid`, Azure DevOps' pull request or work item id). Tangled has no numbers: use `id`.",
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "description": "The forge's own id of the item, as a string: the number again on GitHub, GitLab, Azure DevOps, Forgejo and Gitea; the record's AT-URI (`at://did:.../sh.tangled.repo.pull/<rkey>`) on Tangled.",
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "state": {
      "enum": [
        "open",
        "closed",
        "merged"
      ]
    },
    "draft": {
      "type": "boolean"
    },
    "author": {
      "description": "A user's login (user name) on the forge; on Tangled their handle, else their DID.",
      "type": "string"
    },
    "head": {
      "description": "The source branch.",
      "type": "string"
    },
    "base": {
      "description": "The target branch.",
      "type": "string"
    },
    "head_repository": {
      "description": "The source repository's path when it is a fork (or another Tangled repository).",
      "type": "string"
    },
    "created_at": {
      "description": "A time in RFC 3339 (UTC).",
      "type": "string"
    },
    "updated_at": {
      "description": "A time in RFC 3339 (UTC).",
      "type": "string"
    },
    "url": {
      "description": "The pull request's page.",
      "type": "string"
    },
    "labels": {
      "type": "array",
      "items": {
        "description": "A label's name (a tag on Azure DevOps).",
        "type": "string"
      }
    },
    "comments": {
      "description": "Its conversation's comment count, where the list gives it.",
      "type": "integer",
      "minimum": 0
    },
    "review_requested": {
      "description": "A review is requested from the signed-in account.",
      "type": "boolean"
    },
    "checks": {
      "description": "The head commit's checks, where the list gives them.",
      "enum": [
        "success",
        "failure",
        "pending",
        "none"
      ]
    },
    "body": {
      "description": "The description (Markdown).",
      "type": "string"
    },
    "head_sha": {
      "description": "A full commit id (40 hexadecimal digits).",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_sha": {
      "description": "A full commit id (40 hexadecimal digits).",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_clone_url": {
      "description": "The source repository's clone url when it is a fork.",
      "type": "string"
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sha",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "sha": {
            "description": "A full commit id (40 hexadecimal digits).",
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "title": {
            "description": "The message's first line.",
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "date": {
            "description": "A time in RFC 3339 (UTC).",
            "type": "string"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "status",
          "additions",
          "deletions"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "old_path": {
            "description": "A renamed file's previous path.",
            "type": "string"
          },
          "status": {
            "enum": [
              "added",
              "modified",
              "deleted",
              "renamed",
              "copied"
            ]
          },
          "additions": {
            "type": "integer",
            "minimum": 0
          },
          "deletions": {
            "type": "integer",
            "minimum": 0
          },
          "binary": {
            "type": "boolean"
          }
        }
      }
    },
    "threads": {
      "description": "Review threads (filtered by `threads`).",
      "type": "array",
      "items": {
        "description": "A review thread. A thread without `path` is a pull-request-level discussion (GitLab, Azure DevOps).",
        "type": "object",
        "required": [
          "id",
          "resolved",
          "comments"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The thread's id: pass it as `reply_to` to answer and to eludite.forge.thread_resolve.",
            "type": "string"
          },
          "path": {
            "description": "The file, relative to the repository's root.",
            "type": "string"
          },
          "line": {
            "description": "The line in the head commit's file (1-based); on a deleted line (`side: left`) the base's line.",
            "type": "integer",
            "minimum": 1
          },
          "start_line": {
            "description": "The first line of a multi-line comment.",
            "type": "integer",
            "minimum": 1
          },
          "side": {
            "description": "`right`: the head commit's text; `left`: the base's.",
            "enum": [
              "right",
              "left"
            ]
          },
          "resolved": {
            "type": "boolean"
          },
          "outdated": {
            "description": "The lines changed since the comment: the anchor is where it was.",
            "type": "boolean"
          },
          "comments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "author",
                "body"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "description": "The comment's id.",
                  "type": "string"
                },
                "author": {
                  "description": "A user's login (user name) on the forge; on Tangled their handle, else their DID.",
                  "type": "string"
                },
                "body": {
                  "description": "Markdown.",
                  "type": "string"
                },
                "created_at": {
                  "description": "A time in RFC 3339 (UTC).",
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "pending": {
                  "description": "Part of the signed-in account's pending review, not yet visible to others.",
                  "type": "boolean"
                }
              }
            },
            "minItems": 1
          }
        }
      }
    },
    "conversation": {
      "description": "The pull request's own comments (not on a line).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "author",
          "body"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The comment's id.",
            "type": "string"
          },
          "author": {
            "description": "A user's login (user name) on the forge; on Tangled their handle, else their DID.",
            "type": "string"
          },
          "body": {
            "description": "Markdown.",
            "type": "string"
          },
          "created_at": {
            "description": "A time in RFC 3339 (UTC).",
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "pending": {
            "description": "Part of the signed-in account's pending review, not yet visible to others.",
            "type": "boolean"
          }
        }
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "author",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "author": {
            "description": "A user's login (user name) on the forge; on Tangled their handle, else their DID.",
            "type": "string"
          },
          "state": {
            "description": "GitHub, Forgejo and Gitea review states; GitLab approvals are `approved`; Azure DevOps' votes are `approved` (10), `approved_with_suggestions` (5), `waiting_for_author` (-5), `rejected` (-10); `requested`: asked, not yet reviewed.",
            "enum": [
              "approved",
              "approved_with_suggestions",
              "changes_requested",
              "waiting_for_author",
              "rejected",
              "commented",
              "pending",
              "dismissed",
              "requested"
            ]
          },
          "body": {
            "type": "string"
          },
          "submitted_at": {
            "description": "A time in RFC 3339 (UTC).",
            "type": "string"
          }
        }
      }
    },
    "check_items": {
      "description": "The head commit's checks.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "status",
          "conclusion",
          "has_log",
          "can_rerun"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Pass to eludite.forge.check_log and eludite.forge.check_rerun.",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "description": "GitHub check runs and commit statuses, GitLab pipelines and jobs, Azure DevOps builds and policy evaluations, Forgejo statuses and Actions runs, Tangled workflows.",
            "enum": [
              "check_run",
              "status",
              "pipeline",
              "job",
              "policy",
              "workflow"
            ]
          },
          "status": {
            "enum": [
              "queued",
              "in_progress",
              "completed"
            ]
          },
          "conclusion": {
            "description": "`none` until completed.",
            "enum": [
              "success",
              "failure",
              "neutral",
              "cancelled",
              "skipped",
              "timed_out",
              "action_required",
              "none"
            ]
          },
          "url": {
            "description": "The run's page.",
            "type": "string"
          },
          "started_at": {
            "description": "A time in RFC 3339 (UTC).",
            "type": "string"
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "has_log": {
            "description": "eludite.forge.check_log can read its log.",
            "type": "boolean"
          },
          "can_rerun": {
            "description": "eludite.forge.check_rerun can rerun it.",
            "type": "boolean"
          },
          "required": {
            "description": "Required to merge (branch protection, Azure DevOps' blocking policies).",
            "type": "boolean"
          }
        }
      }
    },
    "mergeable": {
      "type": "object",
      "required": [
        "state",
        "methods"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "description": "Whether it can merge now: `clean`; `conflicts`; `checks_failing` (merge refuses without `force`); `checks_pending`; `blocked` (reviews or rules); `draft`; `unknown` (the forge is still computing).",
          "enum": [
            "clean",
            "conflicts",
            "checks_failing",
            "checks_pending",
            "blocked",
            "draft",
            "unknown",
            "merged",
            "closed"
          ]
        },
        "methods": {
          "description": "The methods this repository allows.",
          "type": "array",
          "items": {
            "enum": [
              "merge",
              "squash",
              "rebase",
              "rebase_merge",
              "fast_forward",
              "semi_linear"
            ]
          }
        },
        "reason": {
          "description": "What the forge said.",
          "type": "string"
        }
      }
    },
    "auto_merge": {
      "description": "Set to merge when checks pass (auto-complete on Azure DevOps).",
      "type": "boolean"
    },
    "approvals": {
      "description": "GitLab: approvals left and given.",
      "type": "object",
      "required": [
        "required",
        "given"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "integer",
          "minimum": 0
        },
        "given": {
          "type": "integer",
          "minimum": 0
        },
        "approved_by": {
          "type": "array",
          "items": {
            "description": "A user's login (user name) on the forge; on Tangled their handle, else their DID.",
            "type": "string"
          }
        }
      }
    },
    "iterations": {
      "description": "Azure DevOps: the pull request's iterations (pushes).",
      "type": "integer",
      "minimum": 0
    },
    "pending_review": {
      "description": "The signed-in account's pending review, collected by eludite.forge.pull_review `add`.",
      "type": "object",
      "required": [
        "comments"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "comments": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "unresolved_threads": {
      "description": "Review threads not resolved.",
      "type": "integer",
      "minimum": 0
    },
    "stale": {
      "description": "The answer came from the cache on disk (`.eludite/forge/`) because a refresh is still running or failed; `age_seconds` says how old it is. A read answers from the cache at once and refreshes off the UI thread.",
      "type": "boolean"
    },
    "fetched_at": {
      "description": "A time in RFC 3339 (UTC).",
      "type": "string"
    },
    "age_seconds": {
      "description": "How long ago the forge sent this answer.",
      "type": "integer",
      "minimum": 0
    },
    "refresh_error": {
      "description": "Why a refresh failed; the cached answer is kept.",
      "type": "object",
      "required": [
        "kind",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "Why: `rate_limited` (with `reset_at`), `network` (offline, timeout, refused), `sign_in_required` (no token stored for the host, or the forge refused it: sign in again), `forbidden` (the account may not), `not_found`, `unsupported` (the forge lacks it), `conflict`, `invalid` (the forge refused the input), `canceled`.",
          "enum": [
            "rate_limited",
            "network",
            "sign_in_required",
            "unauthorized",
            "forbidden",
            "not_found",
            "unsupported",
            "conflict",
            "invalid",
            "canceled",
            "other"
          ]
        },
        "message": {
          "type": "string"
        },
        "host": {
          "description": "The host it concerns.",
          "type": "string"
        },
        "reset_at": {
          "description": "A time in RFC 3339 (UTC).",
          "type": "string"
        }
      }
    }
  }
}
