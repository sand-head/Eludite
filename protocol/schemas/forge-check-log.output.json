{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/Eludite/protocol/schemas/forge-check-log.output.json",
  "title": "eludite.forge.check_log output",
  "description": "A piece of the log.",
  "type": "object",
  "required": [
    "id",
    "text",
    "offset",
    "truncated"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "next_offset": {
      "description": "Where the next piece starts; absent at the end.",
      "type": "integer",
      "minimum": 0
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "description": "The log is longer than this piece.",
      "type": "boolean"
    },
    "url": {
      "type": "string"
    }
  }
}
