{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/Eludite/protocol/schemas/file-save-all.output.json",
  "title": "eludite.file.save_all output",
  "description": "What was written.",
  "type": "object",
  "required": [
    "saved",
    "failed",
    "skipped"
  ],
  "properties": {
    "saved": {
      "description": "Documents written.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "message"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "skipped": {
      "description": "Untitled documents left unsaved.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
