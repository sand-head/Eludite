{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/Eludite/protocol/schemas/debug-output.output.json",
  "title": "eludite.debug.output output",
  "description": "Output lines by cursor.",
  "type": "object",
  "required": [
    "source",
    "lines",
    "next",
    "dropped",
    "total",
    "truncated"
  ],
  "additionalProperties": false,
  "properties": {
    "source": {
      "enum": [
        "program",
        "debug",
        "adapter"
      ]
    },
    "lines": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "seq",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "seq": {
            "description": "The line's sequence number in this session and source.",
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          },
          "stream": {
            "description": "Where the line came from, when known.",
            "enum": [
              "stdout",
              "stderr"
            ]
          }
        }
      }
    },
    "next": {
      "description": "The cursor to pass as `since` next time.",
      "type": "integer",
      "minimum": 0
    },
    "dropped": {
      "description": "Lines at or after `since` the ring overwrote before they were read (it keeps 10,000 per source).",
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "description": "How many lines the session has written to this source.",
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "description": "More lines follow `next` (read them with `since: next`).",
      "type": "boolean"
    }
  }
}
