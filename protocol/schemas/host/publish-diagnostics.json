{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/niello-ide/protocol/schemas/host/publish-diagnostics.json",
  "title": "textDocument/publishDiagnostics (host to shell)",
  "description": "LSP 3.17 PublishDiagnosticsParams plus the generation the warming pull ran under. Diagnostic objects are LSP 3.17 Diagnostic.",
  "x-niello-method": "textDocument/publishDiagnostics",
  "x-niello-kind": "notification",
  "x-niello-direction": "hostToShell",
  "$defs": {
    "params": {
      "type": "object",
      "required": [
        "uri",
        "diagnostics",
        "nielloGeneration"
      ],
      "properties": {
        "uri": {
          "type": "string"
        },
        "version": {
          "type": [
            "integer",
            "null"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "range",
              "message"
            ]
          }
        },
        "nielloGeneration": {
          "description": "Solution generation (see host-rpc.md).",
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
