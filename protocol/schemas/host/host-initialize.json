{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/eludite-ide/protocol/schemas/host/host-initialize.json",
  "title": "eludite/host/initialize",
  "description": "The eludite handshake. Renamed from `initialize` in brief 0007; plain LSP names belong to the forwarded language server.",
  "x-eludite-method": "eludite/host/initialize",
  "x-eludite-kind": "request",
  "x-eludite-direction": "shellToHost",
  "$defs": {
    "params": {
      "type": "object",
      "required": [
        "clientName",
        "clientVersion"
      ],
      "properties": {
        "clientName": {
          "type": "string"
        },
        "clientVersion": {
          "type": "string"
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "hostName",
        "hostVersion",
        "capabilities"
      ],
      "properties": {
        "hostName": {
          "const": "eludite-host"
        },
        "hostVersion": {
          "type": "string"
        },
        "capabilities": {
          "type": "object",
          "required": [
            "languageServer"
          ],
          "properties": {
            "languageServer": {
              "description": "True when a language server is configured; eludite/languageServer/status reports whether it started.",
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
