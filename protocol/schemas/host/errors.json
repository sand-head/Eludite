{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/Eludite/protocol/schemas/host/errors.json",
  "title": "eludite-host error data",
  "description": "The data member of host error responses.",
  "x-eludite-method": "*",
  "x-eludite-kind": "error",
  "x-eludite-direction": "shellToHost",
  "$defs": {
    "contentModified": {
      "description": "Error -32801.",
      "type": "object",
      "required": [
        "requestedGeneration",
        "currentGeneration"
      ],
      "properties": {
        "requestedGeneration": {
          "description": "Solution generation (see host-rpc.md).",
          "type": "integer",
          "minimum": 0
        },
        "currentGeneration": {
          "description": "Solution generation (see host-rpc.md).",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "requestFailed": {
      "description": "Error -32803.",
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "enum": [
            "languageServerUnavailable"
          ]
        }
      }
    },
    "buildInProgress": {
      "description": "Error -32010: eludite/build/start while a build runs.",
      "type": "object",
      "required": [
        "buildId"
      ],
      "properties": {
        "buildId": {
          "description": "The running build.",
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
