{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/eludite-ide/protocol/schemas/host/ping.json",
  "title": "eludite/ping",
  "description": "Liveness check.",
  "x-eludite-method": "eludite/ping",
  "x-eludite-kind": "request",
  "x-eludite-direction": "shellToHost",
  "$defs": {
    "params": {
      "description": "No params: omitted, null, or an empty object/array.",
      "type": [
        "object",
        "array",
        "null"
      ],
      "maxProperties": 0,
      "maxItems": 0
    },
    "result": {
      "type": "object",
      "required": [
        "pong",
        "timestamp"
      ],
      "additionalProperties": false,
      "properties": {
        "pong": {
          "const": true
        },
        "timestamp": {
          "description": "ISO-8601 UTC timestamp from the host clock.",
          "type": "string"
        }
      }
    }
  }
}
