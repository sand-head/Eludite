{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/Eludite/protocol/schemas/search-cancel.output.json",
  "title": "eludite.search.cancel output",
  "description": "The searches stopped (empty when none was running).",
  "type": "object",
  "required": [
    "canceled"
  ],
  "additionalProperties": false,
  "properties": {
    "canceled": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
