{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/Eludite/protocol/schemas/build-cancel.output.json",
  "title": "eludite.build.cancel output",
  "description": "Whether a build was running and is being canceled.",
  "type": "object",
  "required": [
    "canceled"
  ],
  "additionalProperties": false,
  "properties": {
    "canceled": {
      "type": "boolean"
    },
    "build_id": {
      "type": "integer",
      "minimum": 1
    }
  }
}
