{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/Eludite/protocol/schemas/navigation-references.output.json",
  "title": "eludite.navigation.references output",
  "description": "The window's state after the call.",
  "type": "object",
  "required": [
    "symbol",
    "kinds",
    "group_by",
    "search",
    "keep",
    "shown",
    "total",
    "references"
  ],
  "additionalProperties": false,
  "properties": {
    "symbol": {
      "description": "The symbol of the current results.",
      "type": "string"
    },
    "kinds": {
      "description": "The kinds shown.",
      "type": "array",
      "items": {
        "enum": [
          "definition",
          "read",
          "write",
          "reference"
        ]
      }
    },
    "group_by": {
      "description": "The grouping.",
      "enum": [
        "project_file",
        "file",
        "definition",
        "none"
      ]
    },
    "search": {
      "description": "The search text.",
      "type": "string"
    },
    "keep": {
      "description": "Whether the results are kept.",
      "type": "boolean"
    },
    "shown": {
      "description": "References shown after the filter and the search.",
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "description": "References in the window.",
      "type": "integer",
      "minimum": 0
    },
    "references": {
      "description": "The shown references, in the window's order (at most 1000).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "line",
          "column",
          "text",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "project": {
            "description": "The project of the file.",
            "type": "string"
          },
          "path": {
            "description": "The file.",
            "type": "string"
          },
          "line": {
            "description": "1-based line.",
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "description": "1-based column.",
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "description": "The line's text, trimmed.",
            "type": "string"
          },
          "kind": {
            "description": "Visual Studio's Kind column.",
            "enum": [
              "definition",
              "read",
              "write",
              "reference"
            ]
          },
          "kept": {
            "description": "True for a reference of a kept result set (Keep Results).",
            "type": "boolean"
          }
        }
      },
      "maxItems": 1000
    },
    "selected": {
      "description": "The reference F8 last opened (0-based in `references`).",
      "type": "integer",
      "minimum": 0
    }
  }
}
