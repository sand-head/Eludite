{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/Eludite/protocol/schemas/editor-view-state.output.json",
  "title": "eludite.editor view state output",
  "description": "A document's display state after an outlining, word wrap, white space, brace or zoom command (brief 0067). Lines are 1-based.",
  "type": "object",
  "properties": {
    "path": {
      "description": "The document.",
      "type": "string"
    },
    "changed": {
      "description": "Whether the command changed anything (false: nothing to toggle at the caret, no matching brace, already at the zoom limit).",
      "type": "boolean"
    },
    "outlining": {
      "description": "Outlining is on (Stop Outlining turns it off).",
      "type": "boolean"
    },
    "foldSource": {
      "description": "Where the regions came from: the language server's textDocument/foldingRange, or the tree-sitter fold query and #region markers.",
      "enum": [
        "server",
        "syntax"
      ]
    },
    "folds": {
      "description": "The outlining regions, in order of their first line, outermost first (at most 2,000).",
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "properties": {
          "startLine": {
            "description": "The header line, which stays visible.",
            "type": "integer",
            "minimum": 1
          },
          "endLine": {
            "description": "The last line the region hides when collapsed.",
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "region",
              "comment",
              "imports",
              "namespace",
              "type",
              "member",
              "block",
              "manual"
            ]
          },
          "collapsed": {
            "type": "boolean"
          },
          "label": {
            "description": "What the collapsed adornment reads.",
            "type": "string"
          }
        },
        "required": [
          "startLine",
          "endLine",
          "kind",
          "collapsed",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "foldCount": {
      "description": "Regions in the document (folds may be cut at 2,000).",
      "type": "integer",
      "minimum": 0
    },
    "wordWrap": {
      "type": "boolean"
    },
    "whiteSpace": {
      "type": "boolean"
    },
    "zoom": {
      "description": "Percent.",
      "type": "integer",
      "minimum": 20,
      "maximum": 400
    },
    "caret": {
      "type": "object",
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "description": "1-based, in characters.",
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "line",
        "column"
      ],
      "additionalProperties": false
    },
    "selection": {
      "description": "The primary selection's text when it is not empty (Extend to Brace), at most 10,000 characters.",
      "type": "string"
    },
    "visibleLines": {
      "description": "The first and last lines shown, hidden lines aside.",
      "type": "object",
      "properties": {
        "first": {
          "type": "integer",
          "minimum": 1
        },
        "last": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "first",
        "last"
      ],
      "additionalProperties": false
    },
    "stickyLines": {
      "description": "The header lines sticky scroll pins at the top, outermost first.",
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "required": [
    "path",
    "changed",
    "outlining",
    "foldSource",
    "folds",
    "foldCount",
    "wordWrap",
    "whiteSpace",
    "zoom",
    "caret",
    "visibleLines",
    "stickyLines"
  ],
  "additionalProperties": false
}
