{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/Eludite/protocol/schemas/workspace-set-startup-project.output.json",
  "title": "eludite.workspace.set_startup_project output",
  "type": "object",
  "required": [
    "project",
    "path",
    "solution"
  ],
  "additionalProperties": false,
  "properties": {
    "project": {
      "description": "The project's name; with multiple startup projects, the first one that starts.",
      "type": "string"
    },
    "path": {
      "description": "Absolute path of its project file.",
      "type": "string"
    },
    "solution": {
      "description": "Absolute path of the solution it is the startup project of.",
      "type": "string"
    },
    "projects": {
      "description": "With multiple startup projects (brief 0028): each project that starts, in solution order, with its action.",
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "project",
          "path",
          "action"
        ],
        "additionalProperties": false,
        "properties": {
          "project": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "action": {
            "enum": [
              "start",
              "start_without_debugging"
            ]
          }
        }
      }
    }
  }
}
