{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/Eludite/protocol/schemas/nuget-search.output.json",
  "title": "eludite.nuget.search output",
  "description": "The packages found, newest version first per package, and how each source answered.",
  "type": "object",
  "required": [
    "results",
    "sources",
    "truncated"
  ],
  "additionalProperties": false,
  "properties": {
    "results": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "versions": {
            "description": "Newest first, at most 20.",
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": {
            "type": "string"
          },
          "authors": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "downloads": {
            "type": "integer",
            "minimum": 0
          },
          "license": {
            "description": "The SPDX expression or the license's address.",
            "type": "string",
            "minLength": 1
          },
          "project_url": {
            "type": "string",
            "minLength": 1
          },
          "vulnerabilities": {
            "type": "array",
            "items": {
              "description": "A known vulnerability of this version, from the source's registration data (or NuGet Audit's NU1901 to NU1904 warnings in the assets file).",
              "type": "object",
              "required": [
                "severity",
                "advisory_url"
              ],
              "additionalProperties": false,
              "properties": {
                "severity": {
                  "description": "The advisory's severity (NuGet's 0 low, 1 moderate, 2 high, 3 critical).",
                  "enum": [
                    "low",
                    "moderate",
                    "high",
                    "critical"
                  ]
                },
                "advisory_url": {
                  "description": "The advisory's address (a GitHub advisory for nuget.org).",
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "deprecated": {
            "type": "boolean"
          },
          "icon_url": {
            "description": "The package's icon; the window shows it once the host fetched it into its cache (eludite/nuget/icon).",
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "count"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "truncated": {
      "description": "More results exist (raise max_items or page with skip).",
      "type": "boolean"
    }
  }
}
