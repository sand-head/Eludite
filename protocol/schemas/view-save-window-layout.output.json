{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/Eludite/protocol/schemas/view-save-window-layout.output.json",
  "title": "eludite.view.save_window_layout output",
  "type": "object",
  "properties": {
    "saved": {
      "type": "boolean"
    },
    "layout": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "slot": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 9,
              "description": "Ctrl+Alt+<slot> applies it; the first nine layouts in save order have one."
            }
          },
          "required": [
            "name",
            "slot"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "saved",
    "layout"
  ],
  "additionalProperties": false
}
