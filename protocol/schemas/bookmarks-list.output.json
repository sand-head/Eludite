{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/Eludite/protocol/schemas/bookmarks-list.output.json",
  "title": "eludite.bookmarks.list output",
  "description": "The bookmarks in the window's order.",
  "type": "object",
  "required": [
    "bookmarks"
  ],
  "properties": {
    "bookmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "path",
          "line",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line": {
            "description": "1-based; follows edits of the open document.",
            "type": "integer",
            "minimum": 1
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
