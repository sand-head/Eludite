{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/Eludite/protocol/schemas/editor-code-cleanup.output.json",
  "title": "eludite.editor.code_cleanup output",
  "description": "What Code Cleanup did.",
  "type": "object",
  "required": [
    "path",
    "state",
    "applied"
  ],
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "description": "`done` when the command finished; `running` while a language server request is in flight (an agent polls until done, up to 5 seconds); `picker` when a picker opened for the person to choose; `failed` when nothing was applied (see `message`).",
      "enum": [
        "done",
        "running",
        "picker",
        "failed"
      ]
    },
    "applied": {
      "description": "Whether the document changed.",
      "type": "boolean"
    },
    "line": {
      "description": "The caret's line afterwards (1-based).",
      "type": "integer",
      "minimum": 1
    },
    "column": {
      "description": "The caret's column afterwards (1-based, in characters).",
      "type": "integer",
      "minimum": 1
    },
    "message": {
      "description": "Why nothing was applied, or a note on what was.",
      "type": "string"
    },
    "steps": {
      "description": "Each step and what it did.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "step": {
            "type": "string"
          },
          "state": {
            "enum": [
              "applied",
              "unchanged",
              "skipped",
              "failed"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
