{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/Eludite/protocol/schemas/solution-set-configuration.input.json",
  "title": "eludite.solution.set_configuration input",
  "description": "Configuration Manager (Build > Configuration Manager...): change what a project builds in a solution configuration and platform, editing the solution file through eludite-host with its formatting kept (`.sln` `ProjectConfigurationPlatforms` lines, `.slnx` project rules). The solution reloads after the write. From the Build menu without `mappings`, the Configuration Manager dialog opens.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "description": "Cells of the grid to change.",
      "items": {
        "type": "object",
        "required": [
          "project"
        ],
        "additionalProperties": false,
        "properties": {
          "project": {
            "description": "The project's name or path.",
            "type": "string",
            "minLength": 1
          },
          "solution_configuration": {
            "description": "Default: the active solution configuration.",
            "type": "string",
            "minLength": 1
          },
          "solution_platform": {
            "description": "Default: the active solution platform.",
            "type": "string",
            "minLength": 1
          },
          "configuration": {
            "description": "The project configuration; omitted: unchanged.",
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "description": "The project platform; omitted: unchanged.",
            "type": "string",
            "minLength": 1
          },
          "build": {
            "description": "Build checked or cleared; omitted: unchanged.",
            "type": "boolean"
          }
        }
      }
    }
  }
}
