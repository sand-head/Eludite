{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/Eludite/protocol/schemas/bookmarks-toggle.output.json",
  "title": "eludite.bookmarks.toggle output",
  "description": "What toggling did.",
