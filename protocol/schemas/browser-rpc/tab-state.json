{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sand-head/Eludite/protocol/schemas/browser-rpc/tab-state.json",
  "title": "tab/state",
  "description": "Engine-to-shell notification: the tab's address, title or loading state changed (CEF's display and load handlers). Members not present did not change.",
  "x-eludite-method": "tab/state",
  "x-eludite-kind": "notification",
  "x-eludite-direction": "engineToShell",
  "$defs": {
    "params": {
      "type": "object",
      "required": [
        "tab"
      ],
      "properties": {
        "tab": {
          "description": "The tab's id, as tab/create answered it (\"1\", \"2\", ...; never reused in one engine process).",
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "loading": {
          "type": "boolean"
        }
      }
    }
  }
}
